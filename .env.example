# Copy this file to .env in the repository root. Add your own OpenAI API key.
# Launch with: uv run --env-file .env python app.py
# Without a key: file tools, index building, diagrams and local benchmarks work.
# Conversational screening requires the key and access to the selected model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
